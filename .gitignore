gh/
nvim/undodir/
flutter/
peazip/
grammarly-languageserver/
raycast/*
!raycast/settings.json
!raycast/build-rayconfig.sh
!raycast/build-rayconfig.jq
!raycast/README.md
!raycast/Raycast.rayconfig
yarn/
config-venv/
zed/prompts/prompts-library-db.0.mdb/
zed/embeddings/
zed/.tmp*
zed/conversations/

# Session tokens (do not commit)
twscrape/accounts.db
scripts/lyra.d/
gogcli/
edd-cert/
github-copilot/

# Agent config - ignore runtime/state, track behavioral files only.
# Harness-agnostic content lives at the top of agents/; per-harness config
# (settings, hooks, output styles, prompts) lives under agents/harness/<name>/.
agents/*
!agents/skills/
!agents/commands/
!agents/memory/
!agents/personas/
!agents/harness/
agents/docs/

# Zap terminal — ~/.zap is symlinked here (see setup-macos.sh). Track
# settings.toml and keybindings.yaml only: Zap also drops remote-server/, a
# downloaded Linux binary it installs over SSH, plus other machine-local
# runtime state. Same allowlist shape as agents/ above.
zap/*
!zap/settings.toml
!zap/keybindings.yaml

# AssemblyAI - contains API token
/assemblyai/

# macOS / system generated
.DS_Store
.zcompdump*
.zsh_history
.zsh_sessions/

# Python
__pycache__/
*.pyc

# App state (not config we maintain)
astap/
browseruse/
configstore/
darktable/
git/
himalaya/
iterm2/
waveterm/
uv/
vercel-plugin/

# Packaged skill files
*.skill

# Nested third-party MCP server clone with live session cookies — do not commit
mcp-server-amazon/

# Skill runtime state (auth tokens, learned patterns, session data)
agents/skills/*/state/

# Machine-local skills: symlinks into ~/.claude/local-skills/, which is outside
# this repo. These depend on this laptop's environment (e.g. the Anduril gateway)
# and must not sync to other machines or deployments.
agents/skills/WebSearch

# Logseq skill's scratch test graph — regenerable via seed.py --reset
agents/skills/logseq/scripts/tests/logseq-test/

# halflife / trashlog runtime state (logs, locks, state files)
halflife/logs/
halflife/*.lock
trashlog/logs/
trashlog/state.json

# Runtime telemetry / first-use stamps from CLI tools
mlflow/
vercel-plugin/

# .env is committed ENCRYPTED via git-crypt (see .gitattributes)

# Raycast installed-extensions cache (291MB of generated bundles; reinstallable from store)
raycast-x/

# macOS TCC permission snapshots (machine fingerprint - do not publish)
macos/tcc-permissions*.tsv

# ============================================================================
# Machine-local credentials & runtime state (added 2026-08-26)
# These hold LIVE tokens or per-machine identity. This repo is PUBLIC — with
# git-crypt locked the clean filter fails open, so never rely on it alone.
# ============================================================================

# ArgoCD CLI config — contains an OIDC auth-token (JWT)
argocd/

# Confluence CLI — bearer token in config.json, plus local usage stats
confluence-cli/

# Weights & Biases — internal base_url + entity
wandb/

# cagent — per-machine UUID / first-run marker
cagent/

# Tailscale userspace proxy — node private key (tailscaled.state), pid files,
# netmap caches and a multi-MB log. Machine identity; never commit.
tailscale-official-proxy/

# Local backup of the encrypted .env blob (identical to committed HEAD:.env).
# Redundant in-repo; keep it out so it can't be confused for the real thing.
.env.enc

# bunnylol: keep the portable parent config, exclude work/machine-specific
# children (see bunnylol/README for the split).
bunnylol/*
!bunnylol/config.toml

# opencode — unused, fully ignored (not tracked)
opencode/
